{
    "name": "b2b-mcp-server",
    "version": "1.0.0",
    "description": "Production-grade TypeScript B2B MCP Server with S2S OAuth2.0, JWT client credentials, and inbound agent authentication.",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "mock": "tsx watch mock-upstream/server.ts",
        "build": "tsup src/index.ts --format esm --dts --clean",
        "start": "node dist/index.js",
        "lint": "eslint . --ext .ts",
        "lint:fix": "eslint . --ext .ts --fix",
        "test": "vitest run",
        "test:watch": "vitest watch"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.32.2",
        "cors": "^2.8.6",
        "dotenv": "^18.0.10",
        "express": "^5.3.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.6",
        "tsup": "^9.0.0",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^5.1.0"
    }
}
